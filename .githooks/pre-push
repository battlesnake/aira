#!/usr/bin/env bash
set -euo pipefail

# shellcheck source=common.sh
. "$(dirname -- "${BASH_SOURCE[0]}")/common.sh"

# AIRA-315 (RANT-44): a push that changes only Markdown under docs/ skips
# `make ci`, and one that changes only Markdown under docs/ and .aira/tickets/
# runs only the internal/store tests (the package that parses the repository's
# own ticket files). Skipping a gate is a false-pass hazard, so the classifier
# is FAIL-CLOSED: it prints exactly `docs` or `tickets` and returns 0 only when
# every condition below is proven for every ref line git hands it; anything
# else (a git error, an empty push, a tag, a deletion, an unresolvable base, a
# branch not on top of origin/master, any path that is not docs/*.md or
# .aira/tickets/*.md) runs the full `make ci` exactly as before. Design:
# invariant I5 of docs/superpowers/specs/2026-10-25-rant-small-batch-design.md.
#
# Only Markdown: the Go toolchain walks docs/ (a .go file there is a package
# `go test ./...` builds), and fmt-check's `find . -name '*.go'` walks .aira/.
#
# The base is origin/master's TIP, and a ref is judged only when that tip is an
# ancestor of it: an older master commit may never have been tested on its own
# (it was pushed together with its fix), so a branch off it runs full. Its
# paths are `diff-tree --no-renames` from the tip: a docs commit on top of an
# unpushed (or pushed but unchecked) code commit still diffs the code, and
# --no-renames lists both sides of a rename, so `git mv src/x docs/x.md` is not
# docs-only.
#
# errexit does NOT apply inside a function called from `$(...) ||`, so every
# fallible command below carries its own `|| return 1`; and no loop reads from
# a pipe, so a `return` leaves the function, not a subshell.
aira_prepush_scope() {
	local root="$1" base_ref=refs/remotes/origin/master
	local input _local_ref local_sha remote_ref remote_sha extra base changed path
	local refs=0 tickets=0 paths
	base="$(git -C "$root" rev-parse --verify --quiet "$base_ref^{commit}")" || return 1
	[ -n "$base" ] || return 1
	# All of stdin first: `read` would drop a final line with no newline, and an
	# empty stdin becomes one empty line, which the field check refuses.
	input="$(cat)" || return 1
	while IFS=' ' read -r _local_ref local_sha remote_ref remote_sha extra; do
		[ -n "$remote_sha" ] && [ -z "$extra" ] || return 1
		case "$remote_ref" in refs/heads/?*) ;; *) return 1 ;; esac
		case "$local_sha" in "" | *[!0-9a-f]*) return 1 ;; esac
		case "$local_sha" in *[!0]*) ;; *) return 1 ;; esac
		[ "$(git -C "$root" cat-file -t "$local_sha" 2>/dev/null)" = commit ] || return 1
		git -C "$root" merge-base --is-ancestor "$base" "$local_sha" || return 1
		changed="$(git -C "$root" diff-tree -r --no-renames --name-only "$base" "$local_sha")" || return 1
		paths=0
		while IFS= read -r path; do
			case "$path" in
			"") ;;
			docs/?*.md) paths=$((paths + 1)) ;;
			.aira/tickets/?*.md)
				paths=$((paths + 1))
				tickets=$((tickets + 1))
				;;
			*) return 1 ;;
			esac
		done <<<"$changed"
		[ "$paths" -gt 0 ] || return 1
		refs=$((refs + 1))
	done <<<"$input"
	[ "$refs" -gt 0 ] || return 1
	if [ "$tickets" -gt 0 ]; then echo tickets; else echo docs; fi
}

scope=full
if root="$(aira_hook_worktree_root)"; then
	scope="$(aira_prepush_scope "$root")" || scope=full
fi
case "$scope" in
docs)
	printf 'pre-push: every pushed path is Markdown under docs/ (against origin/master); make ci skipped (AIRA-315).\n' >&2
	exit 0
	;;
tickets)
	printf 'pre-push: every pushed path is Markdown under docs/ or .aira/tickets/ (against origin/master); running only the internal/store tests (AIRA-315).\n' >&2
	aira_hook_run_make pre-push test-store
	;;
*)
	aira_hook_run_make pre-push ci
	;;
esac
