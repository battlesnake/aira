#!/usr/bin/env bash
set -euo pipefail

# shellcheck source=common.sh
. "$(dirname -- "${BASH_SOURCE[0]}")/common.sh"

# AIRA-315 (RANT-44), AIRA-359: a push that changes only non-Go files under
# docs/ and Markdown under .aira/tickets/ runs, instead of `make ci`, only the
# one named test that reads those files: `make test-docs` (the whole-tree text
# test) when it touches docs/, `make test-store` (the test that parses the
# repository's own ticket files) when it touches .aira/tickets/, both when it
# touches both. Narrowing a gate is a false-pass hazard, so the classifier is
# FAIL-CLOSED: it prints exactly `docs`, `tickets` or `docs+tickets` and
# returns 0 only when every condition below is proven for every ref line git
# hands it; anything else (a git error, an empty push, a tag, a deletion, an
# unresolvable base, a branch not on top of origin/master, any .go file, any
# path that is not under docs/ or Markdown under .aira/tickets/) runs the full
# `make ci` exactly as before. A narrowed run never records an AIRA-355
# tree-pass marker (its targets do not go through .githooks/ci-pass). Like
# `make ci`, it tests the CHECKED-OUT tree, so it runs only after the AIRA-355
# checks below have refused a pushed branch whose tree is neither that tree nor
# recorded as passed, under the same HEAD re-check, and only from a clean
# worktree (it reads the working files, see below). Design: invariant I5 of
# docs/superpowers/specs/2026-10-25-rant-small-batch-design.md.
#
# No .go file: the Go toolchain walks docs/ (a .go file there is a package
# `go test ./...` builds), and fmt-check's `find . -name '*.go'` walks .aira/.
# go vet/build/test ignore a directory with no .go file, so any other file
# under docs/ is invisible to them. Under .aira/tickets/ only Markdown.
#
# The base is origin/master's TIP, and a ref is judged only when that tip is an
# ancestor of it: an older master commit may never have been tested on its own
# (it was pushed together with its fix), so a branch off it runs full. Its
# paths are `diff-tree --no-renames` from the tip: a docs commit on top of an
# unpushed (or pushed but unchecked) code commit still diffs the code, and
# --no-renames lists both sides of a rename, so `git mv src/x docs/x.md` is not
# docs-only.
#
# errexit does NOT apply inside a function called from `$(...) ||`, so every
# fallible command below carries its own `|| return 1`; and no loop reads from
# a pipe, so a `return` leaves the function, not a subshell.
aira_prepush_scope() {
	local root="$1" base_ref=refs/remotes/origin/master
	local input _local_ref local_sha remote_ref remote_sha extra base changed path
	local refs=0 tickets=0 docs=0 paths
	base="$(git -C "$root" rev-parse --verify --quiet "$base_ref^{commit}")" || return 1
	[ -n "$base" ] || return 1
	# All of stdin first: `read` would drop a final line with no newline, and an
	# empty stdin becomes one empty line, which the field check refuses.
	input="$(cat)" || return 1
	while IFS=' ' read -r _local_ref local_sha remote_ref remote_sha extra; do
		[ -n "$remote_sha" ] && [ -z "$extra" ] || return 1
		case "$remote_ref" in refs/heads/?*) ;; *) return 1 ;; esac
		case "$local_sha" in "" | *[!0-9a-f]*) return 1 ;; esac
		case "$local_sha" in *[!0]*) ;; *) return 1 ;; esac
		[ "$(git -C "$root" cat-file -t "$local_sha" 2>/dev/null)" = commit ] || return 1
		git -C "$root" merge-base --is-ancestor "$base" "$local_sha" || return 1
		changed="$(git -C "$root" diff-tree -r --no-renames --name-only "$base" "$local_sha")" || return 1
		paths=0
		while IFS= read -r path; do
			case "$path" in
			"") ;;
			*.go) return 1 ;;
			docs/?*)
				paths=$((paths + 1))
				docs=$((docs + 1))
				;;
			.aira/tickets/?*.md)
				paths=$((paths + 1))
				tickets=$((tickets + 1))
				;;
			*) return 1 ;;
			esac
		done <<<"$changed"
		[ "$paths" -gt 0 ] || return 1
		refs=$((refs + 1))
	done <<<"$input"
	[ "$refs" -gt 0 ] || return 1
	if [ "$tickets" -gt 0 ] && [ "$docs" -gt 0 ]; then
		echo docs+tickets
	elif [ "$tickets" -gt 0 ]; then
		echo tickets
	else
		echo docs
	fi
}

# AIRA-355: the FULL scope skips `make ci` only when every pushed ref line is a
# well-formed branch update (the same field checks as above) whose commit's
# tree has a recorded `make ci` pass on this machine (see common.sh and
# .githooks/ci-pass). It prints one tree per line and returns 0 only when every
# line is such an update; a deletion, a tag, an empty push or anything it
# cannot resolve returns 1, and the caller then runs `make ci`.
aira_prepush_pushed_trees() {
	local root="$1" input _local_ref local_sha remote_ref remote_sha extra tree refs=0
	input="$(cat)" || return 1
	while IFS=' ' read -r _local_ref local_sha remote_ref remote_sha extra; do
		[ -n "$remote_sha" ] && [ -z "$extra" ] || return 1
		case "$remote_ref" in refs/heads/?*) ;; *) return 1 ;; esac
		case "$local_sha" in "" | *[!0-9a-f]*) return 1 ;; esac
		case "$local_sha" in *[!0]*) ;; *) return 1 ;; esac
		[ "$(git -C "$root" cat-file -t "$local_sha" 2>/dev/null)" = commit ] || return 1
		tree="$(git -C "$root" rev-parse --verify --quiet "$local_sha^{tree}")" || return 1
		aira_ci_pass_is_hash "$tree" || return 1
		printf '%s\n' "$tree"
		refs=$((refs + 1))
	done <<<"$input"
	[ "$refs" -gt 0 ] || return 1
}

# `make ci` below tests the CHECKED-OUT tree, not the pushed commits, so its
# pass is proof only for a pushed branch whose tree IS that tree.
# aira_prepush_unproven <root> <head-tree> prints the first pushed branch
# update whose tree is neither <head-tree> nor recorded as passed, and returns
# 1; it returns 0 when there is none. Deletions and non-branch refs (tags) are
# not judged here: they keep running `make ci` exactly as before. A branch line
# whose local id is not hex or does not resolve is unproven.
aira_prepush_unproven() {
	local root="$1" head_tree="$2" input _local_ref local_sha remote_ref _rest tree
	input="$(cat)" || {
		echo "(unreadable push input)"
		return 1
	}
	while IFS=' ' read -r _local_ref local_sha remote_ref _rest; do
		case "$remote_ref" in refs/heads/?*) ;; *) continue ;; esac
		case "$local_sha" in "" | *[!0-9a-f]*)
			printf '%s (unparseable object id)\n' "$remote_ref"
			return 1
			;;
		esac
		case "$local_sha" in *[!0]*) ;; *) continue ;; esac
		if ! tree="$(git -C "$root" rev-parse --verify --quiet "$local_sha^{tree}")"; then
			printf '%s (unresolvable commit %s)\n' "$remote_ref" "$local_sha"
			return 1
		fi
		if [ -n "$head_tree" ] && [ "$tree" = "$head_tree" ]; then continue; fi
		if aira_ci_pass_marker "$root" "$tree" >/dev/null; then continue; fi
		printf '%s (tree %s)\n' "$remote_ref" "$tree"
		return 1
	done <<<"$input"
}

aira_prepush_head_tree() {
	git -C "$1" rev-parse --verify --quiet 'HEAD^{tree}' 2>/dev/null || true
}

# All of stdin once: the fast-path classifier and the tree-pass checks each
# read it from a here-string, which normalises it exactly as `$(cat)` inside
# the classifier always did.
input="$(cat)" || input=""

scope=full
root=""
if root="$(aira_hook_worktree_root)"; then
	scope="$(aira_prepush_scope "$root" <<<"$input")" || scope=full
else
	root=""
fi
head_tree=""
if [ -n "$root" ]; then
	if trees="$(aira_prepush_pushed_trees "$root" <<<"$input")"; then
		proven=1
		markers=""
		while IFS= read -r tree; do
			if marker="$(aira_ci_pass_marker "$root" "$tree")"; then
				markers="$markers$tree $marker"$'\n'
			else
				proven=0
				break
			fi
		done <<<"$trees"
		if [ "$proven" -eq 1 ]; then
			while IFS=' ' read -r tree marker; do
				[ -n "$tree" ] || continue
				when="$(date -u -r "$marker" +%Y-%m-%dT%H:%M:%SZ 2>/dev/null)" || when="an unknown time"
				printf 'pre-push: tree %s already passed make ci on this machine at %s; skipped (AIRA-355).\n' "$tree" "$when" >&2
			done <<<"$markers"
			exit 0
		fi
	fi
	head_tree="$(aira_prepush_head_tree "$root")"
	if ! unproven="$(aira_prepush_unproven "$root" "$head_tree" <<<"$input")"; then
		printf 'pre-push: refusing the push: %s is neither the checked-out tree (%s) nor recorded as passing make ci on this machine (AIRA-355).\n' "$unproven" "${head_tree:-none}" >&2
		printf 'pre-push: make ci here would test only the checked-out tree. Run make ci in a clean worktree at that commit, or push from one.\n' >&2
		exit 1
	fi
fi

# AIRA-359: a narrowed scope runs its targets in place of `make ci` only
# here, after the AIRA-355 checks above: it too tests the checked-out tree, so
# a pushed branch whose tree is neither that tree nor recorded as passed has
# already been refused, and the HEAD re-check below covers it as well.
#
# The narrowed targets read the WORKING files, while every check above compares
# only tree ids, so an uncommitted, untracked or hidden (assume-unchanged,
# skip-worktree) change would change what is tested without changing any id: a
# committed bad document passes once its fix sits uncommitted, a clean one fails
# on an uncommitted edit.
# Accepted limits (the same as the full gate's, not new here): a git clean/eol
# filter can make a clean worktree's bytes differ from the committed ones, and a
# file edited and restored again DURING the run is not seen by the after-run
# check, which compares only the final state. So a scope narrows only from a CLEAN worktree whose
# tree is HEAD's (the AIRA-355 clean-tree check), re-checked after the run;
# otherwise the push runs the full `make ci`, as before AIRA-315.
if [ "$scope" != full ]; then
	clean_tree=""
	if ! clean_tree="$(aira_ci_pass_clean_tree "$root")" || [ "$clean_tree" != "$head_tree" ]; then
		printf 'pre-push: the worktree has uncommitted, untracked or hidden changes, so a narrowed run would not test the pushed files; running make ci (AIRA-359).\n' >&2
		scope=full
	fi
fi
targets=(ci)
case "$scope" in
docs)
	printf 'pre-push: every pushed path is a non-Go file under docs/ (against origin/master); running only make test-docs instead of make ci (AIRA-315).\n' >&2
	targets=(test-docs)
	;;
tickets)
	printf 'pre-push: every pushed path is Markdown under .aira/tickets/ (against origin/master); running only make test-store instead of make ci (AIRA-315).\n' >&2
	targets=(test-store)
	;;
docs+tickets)
	printf 'pre-push: every pushed path is a non-Go file under docs/ or Markdown under .aira/tickets/ (against origin/master); running only make test-store test-docs instead of make ci (AIRA-315).\n' >&2
	targets=(test-store test-docs)
	;;
esac

status=0
(
	aira_hook_run_make pre-push normal "${targets[@]}"
) || status=$?
if [ "$status" -ne 0 ]; then
	exit "$status"
fi

# The run proved the tree that was checked out when it started: refuse if HEAD
# moved meanwhile, and re-check every pushed branch against the tree now.
if [ -n "$root" ]; then
	head_after="$(aira_prepush_head_tree "$root")"
	if [ "$head_after" != "$head_tree" ]; then
		printf 'pre-push: refusing the push: the checked-out tree changed during make %s (%s -> %s), so the run proves neither (AIRA-355).\n' "${targets[*]}" "${head_tree:-none}" "${head_after:-none}" >&2
		exit 1
	fi
	if ! unproven="$(aira_prepush_unproven "$root" "$head_after" <<<"$input")"; then
		printf 'pre-push: refusing the push: %s has no make ci pass after the run (AIRA-355).\n' "$unproven" >&2
		exit 1
	fi
	# A narrowed run tested the working files: refuse if they stopped matching
	# HEAD during it, since the run may have read the changed ones (AIRA-359).
	if [ "$scope" != full ]; then
		clean_after=""
		if ! clean_after="$(aira_ci_pass_clean_tree "$root")" || [ "$clean_after" != "$head_after" ]; then
			printf 'pre-push: refusing the push: the worktree changed during make %s, so the run proves nothing about the pushed files (AIRA-359).\n' "${targets[*]}" >&2
			exit 1
		fi
	fi
fi
