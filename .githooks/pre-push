#!/usr/bin/env bash
set -euo pipefail

# shellcheck source=common.sh
. "$(dirname -- "${BASH_SOURCE[0]}")/common.sh"

# AIRA-315 (RANT-44): a push that changes only docs/ skips `make ci`, and one
# that changes only docs/ and .aira/tickets/ runs only the internal/store tests
# (the package that parses the repository's own ticket files). Skipping a gate
# is a false-pass hazard, so the classifier is FAIL-CLOSED: it prints exactly
# `docs` or `tickets` and returns 0 only when every condition below is proven
# for every ref line git hands it; anything else (a git error, an empty push, a
# tag, a deletion, an unresolvable base, any path outside the two trees) runs
# the full `make ci` exactly as before. Design: invariant I5 of
# docs/superpowers/specs/2026-10-25-rant-small-batch-design.md.
#
# A ref's changed paths are `diff-tree --no-renames` from its merge-base with
# origin/master: one base rule for every ref, so a docs commit on top of an
# unpushed code commit still diffs the code, and a stale origin/master can only
# move the base back (a wider diff), never narrow it. --no-renames lists both
# sides of a rename, so `git mv src/x docs/x` is not docs-only.
#
# errexit does NOT apply inside a function called from `$(...) ||`, so every
# fallible command below carries its own `|| return 1`; and no loop reads from
# a pipe, so a `return` leaves the function, not a subshell.
aira_prepush_scope() {
	local root="$1" base_ref=refs/remotes/origin/master
	local input _local_ref local_sha remote_ref remote_sha extra base changed path
	local refs=0 tickets=0 paths
	git -C "$root" rev-parse --verify --quiet "$base_ref^{commit}" >/dev/null || return 1
	# All of stdin first: `read` would drop a final line with no newline, and an
	# empty stdin becomes one empty line, which the field check refuses.
	input="$(cat)" || return 1
	while IFS=' ' read -r _local_ref local_sha remote_ref remote_sha extra; do
		[ -n "$remote_sha" ] && [ -z "$extra" ] || return 1
		case "$remote_ref" in refs/heads/?*) ;; *) return 1 ;; esac
		case "$local_sha" in "" | *[!0-9a-f]*) return 1 ;; esac
		case "$local_sha" in *[!0]*) ;; *) return 1 ;; esac
		[ "$(git -C "$root" cat-file -t "$local_sha" 2>/dev/null)" = commit ] || return 1
		base="$(git -C "$root" merge-base "$local_sha" "$base_ref")" || return 1
		[ -n "$base" ] || return 1
		changed="$(git -C "$root" diff-tree -r --no-renames --name-only "$base" "$local_sha")" || return 1
		paths=0
		while IFS= read -r path; do
			case "$path" in
			"") ;;
			docs/?*) paths=$((paths + 1)) ;;
			.aira/tickets/?*)
				paths=$((paths + 1))
				tickets=$((tickets + 1))
				;;
			*) return 1 ;;
			esac
		done <<<"$changed"
		[ "$paths" -gt 0 ] || return 1
		refs=$((refs + 1))
	done <<<"$input"
	[ "$refs" -gt 0 ] || return 1
	if [ "$tickets" -gt 0 ]; then echo tickets; else echo docs; fi
}

scope=full
if root="$(aira_hook_worktree_root)"; then
	scope="$(aira_prepush_scope "$root")" || scope=full
fi
case "$scope" in
docs)
	printf 'pre-push: every pushed path is under docs/ (against origin/master); make ci skipped (AIRA-315).\n' >&2
	exit 0
	;;
tickets)
	printf 'pre-push: every pushed path is under docs/ or .aira/tickets/ (against origin/master); running only the internal/store tests (AIRA-315).\n' >&2
	aira_hook_run_make pre-push test-store
	;;
*)
	aira_hook_run_make pre-push ci
	;;
esac
